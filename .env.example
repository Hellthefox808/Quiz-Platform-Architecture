# Application Configuration
APP_NAME=ApexAssess
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Security & Tokens
SECRET_KEY=generate-a-secure-32-character-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Database URLs
DATABASE_URL=sqlite+aiosqlite:///./quiz_platform.db
SYNC_DATABASE_URL=sqlite:///./quiz_platform.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_SUBMISSION=10

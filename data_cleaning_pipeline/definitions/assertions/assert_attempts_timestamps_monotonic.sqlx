config {
  type: "assertion",
  description: "FEAT-22: Validates timestamp chronological monotonicity in fct_assessment_attempts, ensuring submitted_at_utc >= started_at_utc and started_at_utc IS NOT NULL."
}

SELECT
  attempt_id,
  started_at_utc,
  submitted_at_utc,
  expires_at_utc,
  TIMESTAMP_DIFF(submitted_at_utc, started_at_utc, SECOND) AS duration_diff_seconds
FROM
  ${ref("fct_assessment_attempts")}
WHERE
  started_at_utc IS NULL
  OR (submitted_at_utc IS NOT NULL AND submitted_at_utc < started_at_utc)
  OR (expires_at_utc IS NOT NULL AND expires_at_utc < started_at_utc)

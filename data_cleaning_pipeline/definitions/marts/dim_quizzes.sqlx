config {
  type: "table",
  schema: "quiz_platform_analytics",
  tags: ["marts", "gold"],
  description: "Conformed dimension table for quizzes catalog, versions, and assessment definitions.",
  columns: {
    quiz_id: "Primary key identifier for the quiz (UUID string)",
    title: "Sanitized quiz title",
    slug: "URL-safe quiz identifier slug",
    category_id: "Foreign key referencing categories",
    created_by: "Foreign key referencing author user ID",
    status: "Quiz publication status (DRAFT, PUBLISHED, ARCHIVED)",
    created_at_utc: "ISO UTC timestamp of quiz creation",
    updated_at_utc: "ISO UTC timestamp of last quiz update"
  }
}

SELECT
  quiz_id,
  title,
  slug,
  category_id,
  created_by,
  status,
  created_at_utc,
  updated_at_utc
FROM
  ${ref("stg_quizzes")}
